[Unit]
Description=Configure Pierdziocha OS autologin
After=initial-setup.service
Before=display-manager.service
ConditionPathExists=!/etc/lightdm/lightdm.conf.d/90-pierdziocha-autologin.conf

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/libexec/pierdziocha-autologin.sh

[Install]
WantedBy=graphical.target